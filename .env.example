# PostgreSQL bootstrap superuser (container init only — nothing at runtime
# connects as this role; it exists to create the least-privilege app role below)
POSTGRES_DB=loyalty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Application role: owns the schema, subject to FORCE ROW LEVEL SECURITY.
# This is what core-api and Flyway actually connect as.
APP_DB_USER=loyalty_app
APP_DB_PASSWORD=changeme

# Core API (Java / Spring Boot)
CORE_API_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# AI Service (Python / FastAPI)
AI_SERVICE_PORT=8000
LLM_PROVIDER=fake
LLM_API_KEY=

# Vector store
VECTOR_STORE_URL=

# Web app
VITE_CORE_API_URL=http://localhost:8080
VITE_AI_SERVICE_URL=http://localhost:8000
